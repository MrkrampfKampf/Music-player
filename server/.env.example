# Copy to .env and fill in. Never commit the real file.

# Shared secret the app sends as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 24
ACCESS_TOKEN=

# Where the app is served from. Use your GitHub Pages origin, not "*",
# once things work: "*" lets any website use your server.
ALLOWED_ORIGINS=https://mrkrampfkampf.github.io

# The tool that turns a page URL into a stream URL. Anything yt-dlp
# compatible works.
EXTRACTOR=yt-dlp
EXTRACTOR_ARGS=

# A Netscape cookies.txt, base64 encoded. Sites that answer a request from a
# datacentre address by asking it to sign in will accept this instead.
# It is a live session, so treat it like a password and prefer a throwaway
# account. Leave empty if you do not need it.
COOKIES_B64=

FFMPEG=ffmpeg
PORT=8080

# Guard rails.
MAX_DURATION=7200
MAX_PLAYLIST_ITEMS=100
MAX_CONCURRENT=1
RATE_LIMIT_PER_MINUTE=20
